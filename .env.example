# ============================
# ORACLE
# ============================
ORACLE_HOST=tu_host_oracle
ORACLE_PORT=1521
ORACLE_SERVICE=tu_service
ORACLE_USER=tu_usuario
ORACLE_PASSWORD=tu_password

# Ruta a Oracle Instant Client (requerido solo para Oracle 11g)
# En Linux: /opt/oracle/instantclient_21_12
# En Windows: C:\oracle\instantclient_21_12
# Si esta vacio o no existe, se usa thin mode (Oracle 12c+)
ORACLE_INSTANT_CLIENT_DIR=

# ============================
# POSTGRESQL
# ============================
POSTGRES_HOST=tu_host_postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=tu_base_datos
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_password

# ============================
# CONFIGURACION AUTOMATICA (Opcional)
# ============================
# Si no se definen, se calculan automaticamente segun recursos del servidor
#
# BATCH_SIZE:
# BATCH_MEMORY_PERCENT=0.5    # % de RAM para batch (0.1 - 0.9)
# BATCH_CPU_MULTIPLIER=100000 # Multiplicador por CPU core
# BATCH_SIZE_MIN=10000         # Tamaño minimo de batch
# BATCH_SIZE_MAX=1000000       # Tamaño maximo de batch
# BATCH_BYTES_PER_CELL=100     # Bytes estimados por celda
#
# THREADS Y PREFETCH:
# THREADS_EXTRACT=auto         # Threads paralelos para extraccion (auto = cores/2)
# THREADS_LOAD=auto            # Threads paralelos para carga (auto = threads_extract/2)
# PREFETCH_CHUNKS=auto         # Chunks a pre-cargar adelante (auto = segun RAM)
#
# COMPRESION:
# USE_COMPRESSION=auto         # Comprimir datos (auto = si registros > 500 bytes o RAM < 4GB)
